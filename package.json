{
  "name": "roaming",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:asset-cache": "pnpm build && node --test tests/asset-cache-build.test.mjs && pnpm --filter @dontstarve-web/ui exec playwright test --config asset-cache.playwright.config.ts",
    "preview": "vite preview",
    "check:conventions": "node scripts/check-conventions.mjs --summary --baseline scripts/conventions-baseline.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "extract:lua": "node tools/lua-extractor/pighead.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.184.1",
    "eslint": "9.39.4",
    "luaparse": "0.3.1",
    "prettier": "3.6.2",
    "stats-gl": "^4.2.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "^8.0.12",
    "wasmoon": "1.16.0"
  },
  "dependencies": {
    "@dontstarve-web/animation": "workspace:*",
    "@dontstarve-web/display": "workspace:*",
    "@dontstarve-web/inventory": "workspace:*",
    "@dontstarve-web/prefab": "workspace:*",
    "@dontstarve-web/signals": "workspace:*",
    "@dontstarve-web/sound": "workspace:*",
    "@dontstarve-web/stategraphs": "workspace:*",
    "@dontstarve-web/ui": "workspace:*",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "cannon-es": "^0.20.0",
    "cannon-es-debugger": "^1.0.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  }
}
