{
  "name": "@dontstarve-web/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cursor-label": "./src/cursor-label.ts"
  },
  "scripts": {
