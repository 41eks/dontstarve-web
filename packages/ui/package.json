    "@dontstarve-web/prefab": "workspace:*",
    "@dontstarve-web/signals": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "@playwright/test": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.14"
  }
