#!/usr/bin/env bash
# Prettier (.prettierrc.json) and ESLint (eslint.config.mjs) on the files this commit adds or changes. Enabled by
# `pnpm install`'s prepare script (git config core.hooksPath .githooks). It checks the files as they are in the
# working tree.
set -euo pipefail

mapfile -d '' code < <(git diff --cached --name-only --diff-filter=ACMR -z -- \
  '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' '*.mjs' '*.cjs')
mapfile -d '' styles < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.css')
formatted=("${code[@]}" "${styles[@]}")

failed=0
# .prettierignore still applies to files named on the command line.
if (( ${#formatted[@]} > 0 )) && ! pnpm exec prettier --check --log-level warn -- "${formatted[@]}"; then
  echo 'pre-commit: Prettier found unformatted files. Run pnpm exec prettier --write <file> and stage them again.' >&2
  failed=1
fi
if (( ${#code[@]} > 0 )) && ! pnpm exec eslint --no-warn-ignored -- "${code[@]}"; then
  echo 'pre-commit: ESLint failed. Fix the files above (pnpm exec eslint --fix <file>) and stage them again.' >&2
  failed=1
fi
exit "$failed"
